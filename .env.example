# Settings template. Copy to apps/web/.env.local (local) or add in Vercel -> Project -> Settings -> Environment Variables.
# Never put real values in this file: it is uploaded to GitHub.

# ---- Website (apps/web) ----
NEXT_PUBLIC_SITE_URL=https://apnaokara.pk
# Database connection (local: embedded PostgreSQL; live: Supabase -> Connect -> "Transaction pooler" string)
DATABASE_URL=postgres://postgres:CHANGE-ME@localhost:5432/apna_okara
# Long random text (48+ characters) used to sign admin and Rishta logins
ADMIN_SESSION_SECRET=CHANGE-ME-to-a-long-random-text
# Long random text; Vercel Cron sends it to /api/cron
CRON_SECRET=CHANGE-ME-to-another-long-random-text
# Live site only: 1 = really send app push notifications (needs the Expo project)
PUSH_SEND=0
# Optional: Expo access token for push (Expo -> Account settings -> Access tokens)
EXPO_ACCESS_TOKEN=
# 1 = block search engines (for test copies of the site)
SEO_BLOCK_ALL=0

# ---- Mobile app (apps/mobile/.env) ----
EXPO_PUBLIC_SITE_URL=https://apnaokara.pk
# Local testing on your phone (Expo Go): your computer's Wi-Fi IP, e.g. http://192.168.1.10:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
