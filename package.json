{
  "name": "apna-okara",
  "version": "0.1.0",
  "private": true,
  "description": "Apna Okara: local marketplace, services, business directory and rishta for Okara, Sahiwal and Pakpattan",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@apna-okara/web",
    "build:web": "npm run build --workspace=@apna-okara/web",
    "dev:mobile": "npm run start --workspace=@apna-okara/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:generate": "node --experimental-strip-types scripts/generate-seed.ts",
    "images": "node scripts/make-images.mjs",
    "db:setup": "node scripts/db.mjs setup",
    "db:start": "node scripts/db.mjs start",
    "db:reset": "node scripts/db.mjs reset",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:query": "node scripts/db.mjs query",
    "admin:create": "node scripts/create-admin.mjs",
    "social": "node scripts/make-social.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "bcryptjs": "2.4.3",
    "embedded-postgres": "17.11.0-beta.19",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
