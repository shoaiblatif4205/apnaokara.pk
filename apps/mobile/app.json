{
  "expo": {
    "name": "Apna Okara",
    "slug": "apna-okara",
    "scheme": "apnaokara",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FAFB",
    "primaryColor": "#15803D",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#15803D"
    },
    "ios": {
      "bundleIdentifier": "pk.apnaokara.app",
      "supportsTablet": true
    },
    "android": {
      "package": "pk.apnaokara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#15803D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-notifications", { "icon": "./assets/notification-icon.png", "color": "#15803D" }]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
