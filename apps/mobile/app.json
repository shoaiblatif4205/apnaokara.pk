{
  "expo": {
    "name": "Apna Okara",
    "slug": "apna-okara",
    "scheme": "apnaokara",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F9FAFB",
    "primaryColor": "#15803D",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#15803D"
